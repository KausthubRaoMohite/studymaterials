      "seed": 1552794773,
      "version": 425,
      "versionNonce": 211461211,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1783922593100,
      "link": null,
      "locked": false,
      "text": "Functional Requirements:\n- Write to the server with the score/append/upsert/createIfNot()\n- Fetch the top N players/users - IMPORTANTLY TOP 100\n- Specific Rank fetch\n",
      "fontSize": 19.272727272727266,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Functional Requirements:\n- Write to the server with the score/append/upsert/createIfNot()\n- Fetch the top N players/users - IMPORTANTLY TOP 100\n- Specific Rank fetch\n",
      "autoResize": false,
      "lineHeight": 1.25
    },
