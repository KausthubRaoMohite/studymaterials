      "text": "Alternative \nLeader board Service:\n\nStorage of live\nleaderboard:\nUsing HashMap and B+\ntrees",
      "fontSize": 20,
      "fontFamily": 5,
      "textAlign": "center",
      "verticalAlign": "middle",
      "containerId": "IaGUKMBLe39-9jiS3R4T6",
      "originalText": "Alternative \nLeader board Service:\n\nStorage of live leaderboard:\nUsing HashMap and B+ trees",
      "autoResize": true,
      "lineHeight": 1.25
    },
    {
      "id": "rQI6msbIv1Xt7faZ88ZO6",
      "type": "text",
      "x": 2728.750830861621,
      "y": 1231.1784281101504,
      "width": 256.27693680062885,
      "height": 50,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "dashed",
      "roughness": 1,
      "opacity": 100,
