      "updated": 1783922593100,
      "link": null,
      "locked": false,
      "text": "Core-scope:\n- Design a real-time leader board \n- Top n players are queried and displayed\n- Sort the players by ingesting the score",
      "fontSize": 20,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Core-scope:\n- Design a real-time leader board \n- Top n players are queried and displayed\n- Sort the players by ingesting the score",
      "autoResize": true,
      "lineHeight": 1.25
    },
    {
      "id": "AjR978XOYvruD00nI5V_z",
      "type": "text",
      "x": 2807.057390654571,
      "y": -86.73021294654404,
      "width": 657.951194069602,
      "height": 120.45454545454541,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "#ffffff",
      "fillStyle": "solid",
