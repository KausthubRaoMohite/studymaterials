      "updated": 1783922593100,
      "link": null,
      "locked": false,
      "text": "1. POST - /api/v1/upsert-scores\nRequestBody:{\n    userId,\n    score,\n    timestamp\n}\n\n2. GET - /api/get-scores?top=100\nQueryParam: top: 100[default]\nResponse: {\n  leaderboard: [<position,\n  player>]\n}\n\n3. GET - /api/rank?player=playerId\nFetches the rank of the player",
      "fontSize": 20,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "1. POST - /api/v1/upsert-scores\nRequestBody:{\n    userId,\n    score,\n    timestamp\n}\n\n2. GET - /api/get-scores?top=100\nQueryParam: top: 100[default]\nResponse: {\n  leaderboard: [<position,\n  player>]\n}\n\n3. GET - /api/rank?player=playerId\nFetches the rank of the player",
      "autoResize": true,
      "lineHeight": 1.25
    },
