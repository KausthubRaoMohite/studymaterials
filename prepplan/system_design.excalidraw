    {
      "id": "uvIVt-HE2m9yXmFOJitJO",
      "type": "text",
      "x": 4627.422840953058,
      "y": 1037.1322277596548,
      "width": 146,
      "height": 100,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "#ffffff",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "b15",
      "roundness": null,
      "seed": 1524462939,
      "version": 440,
      "versionNonce": 1779031867,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1783922597104,
      "link": null,
      "locked": false,
      "text": "Maintains open\nconnection \nwith\nuserId/client",
      "fontSize": 20,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Maintains open connection \nwith userId/client",
      "autoResize": false,
      "lineHeight": 1.25
    },
    {
      "id": "33z_CWN9bOo3-cIMjl2Z6",
      "type": "text",
      "x": 4827.422840953058,
      "y": 1089.1322277596548,
      "width": 328,
      "height": 450,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "#ffffff",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "b16",
      "roundness": null,
      "seed": 1892754171,
      "version": 797,
      "versionNonce": 1839218651,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1783922597104,
      "link": null,
      "locked": false,
      "text": "When message sent, user to user\nis called a chat, a chat can be a\ngroup chat or a one-2 -one.\n\n- So all the participants of that\nchat, are given the message.\n\n- The message is stored in the\ninbox across each user's inbox.\n\n- When the user is online and\nreachable, the messages are\nunloaded, and we wait for an\nacknowledgement from receiving\nuser.\n\n-When ACK is received, the inbox\nis cleared else is stored as is.",
      "fontSize": 20,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "When message sent, user to user  is called a chat, a chat can be a group chat or a one-2 -one.\n\n- So all the participants of that chat, are given the message.\n\n- The message is stored in the inbox across each user's inbox.\n\n- When the user is online and reachable, the messages are unloaded, and we wait for an acknowledgement from receiving user.\n\n-When ACK is received, the inbox is cleared else is stored as is.",
      "autoResize": false,
      "lineHeight": 1.25
    },
