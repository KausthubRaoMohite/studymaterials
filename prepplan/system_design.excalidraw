    {
      "id": "kB8yAFFeZ7C4NI2-txrPU",
      "type": "text",
      "x": 5265.422840953058,
      "y": 1269.9655560067251,
      "width": 638.0394897460938,
      "height": 250,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "#ffffff",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "b1B",
      "roundness": null,
      "seed": 2061664821,
      "version": 846,
      "versionNonce": 1387264603,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1783922597104,
      "link": null,
      "locked": false,
      "text": "To solve Horizontal scaling:\nWe use a lightweight redis pub-sub here:\n\nWE FIRST CHECK THE HASH-MAP LOCAL \nTO THE SERVER: USER-2-CONNECTION (No network overhead)\n\n- We create topics/channels based off of the users present.\n- The Receiving user is subscribed to their topic/channel.\n- The sending user publishes to the receiving user's topic/channel\n- This can support dynamic pub and sub at runtime",
      "fontSize": 20,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "To solve Horizontal scaling:\nWe use a lightweight redis pub-sub here:\n\nWE FIRST CHECK THE HASH-MAP LOCAL \nTO THE SERVER: USER-2-CONNECTION (No network overhead)\n\n- We create topics/channels based off of the users present.\n- The Receiving user is subscribed to their topic/channel.\n- The sending user publishes to the receiving user's topic/channel\n- This can support dynamic pub and sub at runtime",
      "autoResize": true,
      "lineHeight": 1.25
    },
