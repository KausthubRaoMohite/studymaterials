      "link": null,
      "locked": false,
      "text": "Design URL Shortener",
      "fontSize": 20,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Design URL Shortener",
      "autoResize": false,
      "lineHeight": 1.25
    },
    {
      "id": "0GF6y96CXtC7s-TN5K7nZ",
      "type": "text",
      "x": 205.99178680317763,
      "y": -174.09919649803078,
      "width": 592.2616781311606,
      "height": 175,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "a3",
      "roundness": null,
      "seed": 625122933,
      "version": 293,
      "versionNonce": 803565717,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1783917242619,
      "link": null,
      "locked": false,
      "text": "Core concept: \n\n- Service that takes a long URL \nfrom the user and returns a shortened URL.\n\n- When the Shortened URL is visited the user is redirected\nto the  original long URL",
      "fontSize": 20,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Core concept: \n\n- Service that takes a long URL \nfrom the user and returns a shortened URL.\n\n- When the Shortened URL is visited the user is redirected to the  original long URL",
      "autoResize": false,
      "lineHeight": 1.25
    },
    {
      "id": "s_lUwqcZTLhHxmqPak3-M",
      "type": "text",
      "x": 208.19804073136532,
      "y": 59.82808552106923,
      "width": 853.7394409179688,
      "height": 100,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "a5",
      "roundness": null,
      "seed": 1256536891,
      "version": 343,
      "versionNonce": 199469653,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1783917244290,
      "link": null,
      "locked": false,
      "text": "Functional Requirements:\n\n1. The user must be able to upload/register a long URL and receive a shortened URL\n2. The user must be redirected to the original long URL when shortened URL is visited",
      "fontSize": 20,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Functional Requirements:\n\n1. The user must be able to upload/register a long URL and receive a shortened URL\n2. The user must be redirected to the original long URL when shortened URL is visited",
      "autoResize": true,
      "lineHeight": 1.25
    },
    {
      "id": "WOBXyRs8iK9N0u41nBWV1",
      "type": "text",
      "x": 198.62160461031613,
      "y": 227.4646611419965,
      "width": 946.4993286132812,
      "height": 150,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "a6",
      "roundness": null,
      "seed": 651282645,
      "version": 793,
      "versionNonce": 389051093,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1783917246083,
      "link": null,
      "locked": false,
      "text": "Non- Functional Requirements:\n\n1. Low-latency: Quick resolution\n2. Availability of the system to keep up with redirecting the traffic of the original long URL site\n3. Consistency based on the link's expiry, if goes down GOES down until re-pay?\n",
      "fontSize": 20,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Non- Functional Requirements:\n\n1. Low-latency: Quick resolution\n2. Availability of the system to keep up with redirecting the traffic of the original long URL site\n3. Consistency based on the link's expiry, if goes down GOES down until re-pay?\n",
      "autoResize": true,
      "lineHeight": 1.25
    },
    {
      "id": "vpb3n7e51WMQo-wVtsb8X",
      "type": "text",
      "x": 208.90204625408006,
      "y": 424.25672510778804,
      "width": 890.6594684357422,
      "height": 275,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "a9",
      "roundness": null,
      "seed": 596130389,
      "version": 491,
      "versionNonce": 819410837,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1783917247902,
      "link": null,
      "locked": false,
      "text": "API Design:\n\n1. POST - /api/v1/register\n\nRequest Body: {\n    OriginalUrl:\n    other params:\n}\n\n2. GET - /shortened-url\nResponse: 302 redirect to old URL without browser cache - tiny latency trade-off",
      "fontSize": 20,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "API Design:\n\n1. POST - /api/v1/register\n\nRequest Body: {\n    OriginalUrl:\n    other params:\n}\n\n2. GET - /shortened-url\nResponse: 302 redirect to old URL without browser cache - tiny latency trade-off",
      "autoResize": false,
      "lineHeight": 1.25
    },
