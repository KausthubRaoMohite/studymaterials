      "updated": 1783922597104,
      "link": null,
      "locked": false,
      "text": "Design a 1-to-1 chat app",
      "fontSize": 20,
      "fontFamily": 5,
      "textAlign": "center",
      "verticalAlign": "middle",
      "containerId": "Hf7DuOb255EibUKfL6DiK",
      "originalText": "Design a 1-to-1 chat app",
      "autoResize": true,
      "lineHeight": 1.25
    },
    {
      "id": "eZfA3qbK9KAOYD_ScnAUo",
      "type": "text",
      "x": 4456.922859390761,
      "y": -86.83996627619308,
      "width": 687.4999999999997,
      "height": 100,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "b0d",
      "roundness": null,
      "seed": 2015933973,
      "version": 408,
      "versionNonce": 2056752027,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1783922597104,
      "link": null,
      "locked": false,
      "text": "Core-scope:\n- Design a one-to-one chat app, that instantly delivers message\nwithout any polling. \n- User A should instantly receive message sent by User B",
      "fontSize": 20,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Core-scope:\n- Design a one-to-one chat app, that instantly delivers message without any polling. \n- User A should instantly receive message sent by User B",
      "autoResize": false,
      "lineHeight": 1.25
    },
    {
      "id": "v_KlpmS8gJzU2qHoR9I6q",
      "type": "text",
      "x": 4455.672856211846,
      "y": 55.24336069931144,
      "width": 895.4166666666672,
      "height": 150,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "b0g",
      "roundness": null,
      "seed": 1144586069,
      "version": 410,
      "versionNonce": 209281083,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1783922597104,
      "link": null,
      "locked": false,
      "text": "Functional Requirements:\n- User A must send message to User B.\n- Receive message instantly, when online\n\nOut-of-scope/later talks:\n- Send attachments: Images, Videos, etc",
      "fontSize": 20,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Functional Requirements:\n- User A must send message to User B.\n- Receive message instantly, when online\n\nOut-of-scope/later talks:\n- Send attachments: Images, Videos, etc",
      "autoResize": false,
      "lineHeight": 1.25
    },
    {
      "id": "24KguiTELQl9IiOvphTGc",
      "type": "text",
      "x": 4452.964522878514,
      "y": 248.16002736597818,
      "width": 657.0833333333342,
      "height": 125,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "b0h",
      "roundness": null,
      "seed": 1414906075,
      "version": 1006,
      "versionNonce": 2021105883,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1783922597104,
      "link": null,
      "locked": false,
      "text": "Non - Functional Requirements:\n- Low Latency: Messages reach almost instantly\n- High delivery success rate\n- High Availability, making our system up and ready to serve users\n- Discard message, not to use our storages like a drive",
      "fontSize": 20,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Non - Functional Requirements:\n- Low Latency: Messages reach almost instantly\n- High delivery success rate\n- High Availability, making our system up and ready to serve users\n- Discard message, not to use our storages like a drive",
      "autoResize": false,
      "lineHeight": 1.25
    },
