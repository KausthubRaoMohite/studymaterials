      "isDeleted": false,
      "boundElements": [],
      "updated": 1783922593100,
      "link": null,
      "locked": false,
      "text": "Non - Functional Requirements:\n- High write capabilities\n- Low latency in fetching\n- Eventual Consistant - show ranking when queried everywhere\n- Highly available\n",
