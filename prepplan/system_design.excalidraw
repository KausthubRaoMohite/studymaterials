      "isDeleted": false,
      "boundElements": null,
      "updated": 1783922593100,
      "link": null,
      "locked": false,
      "text": "sharded based off of the\nplayerId's hash.",
      "fontSize": 20,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "sharded based off of the playerId's hash.",
      "autoResize": false,
      "lineHeight": 1.25
    },
    {
      "id": "nlolV0XfzOdgJupfTjW4m",
      "type": "text",
      "x": 2731.2150321770114,
      "y": 1321.9958899335118,
      "width": 256.27693680062885,
      "height": 175,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "dashed",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "b0X",
      "roundness": null,
      "seed": 313525755,
      "version": 379,
      "versionNonce": 2021881947,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1783922593100,
      "link": null,
      "locked": false,
      "text": "Global score can be\ngotten by querying all the\ntop 100 in all shards and\nthen resolving conflicts\nwith score - use\ntimestamp, last update,\netc.",
      "fontSize": 20,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Global score can be gotten by querying all the top 100 in all shards and then resolving conflicts with score - use timestamp, last update, etc.",
      "autoResize": false,
      "lineHeight": 1.25
    },
